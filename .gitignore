# Generated exercise data — rebuilt from your seed by `lab generate`, never committed.
# Anchored with a leading slash: an unanchored `data/` would also match the
# lab/data package and silently drop it from commits.
/data/
*.duckdb
*.duckdb.wal

# Per-learner session state: your seed and your progress
/.lab/

# Python
__pycache__/
*.py[cod]
/.venv/
/venv/
*.egg-info/
/dist/
/build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store

# NOTE: .corrections/ is deliberately NOT ignored. It ships with the repo so
# `lab check` can grade offline; it is hidden by convention, not by git.
